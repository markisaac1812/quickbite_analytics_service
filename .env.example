# ── analytics-service ─────────────────────────────────────────────
PORT=4002
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# SHARED SECRETS — must be byte-identical across services:
#   ACCESS_SECRET          == core-service ACCESS_SECRET == order-service ACCESS_SECRET
#   CORE_INTERNAL_API_KEY  == core-service INTERNAL_API_KEY == order-service CORE_INTERNAL_API_KEY
# Generate once, paste into all three .env files (prod values come from a secret store):
#   openssl rand -base64 48 | tr -d '\n'      (or: python -c "import secrets;print(secrets.token_urlsafe(48))")
ACCESS_SECRET=change-me-same-as-core
CORE_INTERNAL_API_KEY=change-me-same-as-core

# Guards this service's own /internal routes (none mounted yet).
INTERNAL_API_KEY=

# ── MongoDB ───────────────────────────────────────────────────────
# directConnection works for both a standalone mongod and a 1-node replica set.
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=quickbite_analytics
MONGO_CONNECT_TIMEOUT=10s
MONGO_MAX_POOL_SIZE=50
# auto: transactions when the server is a replica set (exactly-once applies), else fall back
# on:   require a replica set (boot fails on standalone)      off: never use transactions
MONGO_TRANSACTIONS=auto

# ── RabbitMQ: inbound order.events from order-service ─────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_ORDER_EVENTS_QUEUE=analytics-service.order-events
RABBITMQ_ORDER_EVENTS_BINDINGS=order.#,payment.#
RABBITMQ_ORDER_EVENTS_DLX=analytics-service.order-events.dlx
RABBITMQ_ORDER_EVENTS_DLQ=analytics-service.order-events.dlq
RABBITMQ_PREFETCH=32
RABBITMQ_CONNECT_ATTEMPTS=5
RABBITMQ_RECONNECT_MAX=15s
EVENT_HANDLER_TIMEOUT=10s

# ── RabbitMQ: inbound core.events (rbac.permissions_changed) ──────
CORE_EVENTS_ENABLED=true
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=analytics-service.core-events
RABBITMQ_CORE_EVENTS_BINDINGS=rbac.#
RABBITMQ_CORE_EVENTS_DLX=analytics-service.core-events.dlx
RABBITMQ_CORE_EVENTS_DLQ=analytics-service.core-events.dlq
RABBITMQ_CORE_EVENTS_PREFETCH=4

# ── core-service (sync, internal API) ─────────────────────────────
CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_HTTP_TIMEOUT=3s
CORE_HTTP_ATTEMPTS=3

# In-process RBAC permission cache, per restaurantRole.
RBAC_CACHE_TTL=5m
